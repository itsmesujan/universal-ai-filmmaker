{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/universal-ai-filmmaker/continuity.schema.json",
  "title": "Universal Continuity Ledger",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^character:[a-z0-9-]+:v[0-9]+$"
          },
          "appearance": {
            "type": "string"
          },
          "costume": {
            "type": "string"
          },
          "accessories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "voice": {
            "type": "string"
          },
          "movement_style": {
            "type": "string"
          },
          "state_overrides": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^location:[a-z0-9-]+:v[0-9]+$"
          },
          "layout_reference": {
            "type": "string"
          },
          "landmarks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entrances_exits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "light_direction": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^prop:[a-z0-9-]+:v[0-9]+$"
          },
          "owner": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "position_history": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "time_and_weather": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "time"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "weather": {
            "type": "string"
          },
          "light_source": {
            "type": "string"
          },
          "light_direction": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "screen_geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "axis": {
            "type": "string"
          },
          "screen_left": {
            "type": "string"
          },
          "screen_right": {
            "type": "string"
          },
          "travel_directions": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "object_state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "subject"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "costume": {
            "type": "string"
          },
          "damage": {
            "type": "string"
          },
          "dirt": {
            "type": "string"
          },
          "wetness": {
            "type": "string"
          },
          "held_items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "emotional_state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shot_id"
        ],
        "properties": {
          "shot_id": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "class"
        ],
        "properties": {
          "shot_id": {
            "type": "string"
          },
          "class": {
            "type": "string",
            "enum": [
              "IDENTITY",
              "STATE",
              "GEOGRAPHY",
              "LIGHTING",
              "OBJECTS",
              "EMOTIONAL",
              "OTHER"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "repair",
              "re-keyframe",
              "accept-with-compromise",
              "regenerate",
              "open"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
